{
  "name": "talnex-mcp",
  "version": "0.1.0",
  "description": "MCP server for TalNex: lets an AI assistant create checks, read proof cards and watch checks live through the TalNex API",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "talnex-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "npm run build && node --experimental-strip-types scripts/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
