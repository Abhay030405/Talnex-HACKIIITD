# TalNex settings. Copy to .env and fill in. Never commit .env.
# Secrets are left empty here. Missing required values stop the service with a clear message.

# --- Postgres ---
POSTGRES_USER=talnex
POSTGRES_PASSWORD=talnex_local_password
POSTGRES_DB=talnex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full connection address used by Go and Python
DATABASE_URL=postgres://talnex:talnex_local_password@postgres:5432/talnex?sslmode=disable

# --- File storage (RustFS locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://s3:9000
# Address a browser can reach, used only for screenshot links (inside Docker the storage is s3:9000, which a browser cannot open).
# In production leave it empty when the storage address is already public.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=talnex
S3_ACCESS_KEY=talnex_local_access
S3_SECRET_KEY=talnex_local_secret_key
# Seconds a view link stays valid
S3_VIEW_LINK_TTL_SECONDS=300

# --- Go API ---
API_PORT=8080
# Shared secret the website and Go API use to trust each other (Auth.js session check)
AUTH_SECRET=
# Where the website is served (used for CORS)
WEB_ORIGIN=http://localhost:3000

# --- Website (Next.js) ---
WEB_PORT=3000
# Address the website server uses to reach the Go API
API_BASE_URL=http://api:8080
# The address people open in the browser (Auth.js uses it for sign-in redirects)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Email-only sign-in for local work. Keep false in production.
ENABLE_DEV_LOGIN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Job queue ---
# Stage time limits and the number of tries per job are data in the database (pipeline_stages / jobs).
# How long workers wait between checks when no wake-up signal arrives, in seconds
JOB_POLL_SECONDS=5
# How often stuck jobs (past their time limit) are failed, in seconds
JOB_REAP_SECONDS=30
# Base wait before a failed job is tried again (grows with each try), in seconds
JOB_RETRY_DELAY_SECONDS=30
# How many Go jobs one Go worker runs at once
GO_WORKER_CONCURRENCY=4
# How many Python AI jobs one worker runs at once
AI_WORKER_CONCURRENCY=5
GO_WORKER_HEALTH_PORT=8081
AI_WORKER_HEALTH_PORT=8082
# Folder the migrate command reads (inside the container)
MIGRATIONS_DIR=/app/migrations
# Turns on /v1/dev/* test endpoints. Keep false in production.
ENABLE_DEV_ENDPOINTS=true

# --- Models (OpenRouter) ---
# Which service answers model calls: openrouter or azure_foundry. The other one stays configured but is not called.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Tries after the first when a model call is rate limited or the server errors
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TIMEOUT_SECONDS=120
# Most tokens one model answer may use when a call sets no limit itself (stops OpenRouter asking for the model's 131072 maximum)
OPENROUTER_MAX_TOKENS=16384
# Azure AI Foundry (used when LLM_PROVIDER=azure_foundry). One deployment answers every model role above.
# The endpoint ends in /openai/v1. The key is in the Azure portal under the resource's Keys and Endpoint.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# The deployment name, for example DeepSeek-V4.1-Flash
AZURE_FOUNDRY_MODEL=
# Dollars per million tokens, so the cost report can price each call (Azure sends no cost). Leave empty if unknown.
AZURE_FOUNDRY_PRICE_IN_PER_M=
AZURE_FOUNDRY_PRICE_OUT_PER_M=
# Model for each role. Roles are fixed. One model serves every role for now (it reads text and images).
MODEL_VIDEO_READER=deepseek/deepseek-v4.1-flash
MODEL_CLAIM_READER=deepseek/deepseek-v4.1-flash
MODEL_TEST_PLANNER=deepseek/deepseek-v4.1-flash
# The model that chooses each click while testing a live site
MODEL_AGENT=deepseek/deepseek-v4.1-flash
MODEL_PROOF_CHECKER=deepseek/deepseek-v4.1-flash
MODEL_OPINION_A=deepseek/deepseek-v4.1-flash
MODEL_OPINION_B=deepseek/deepseek-v4.1-flash
MODEL_COPY_REVIEW=deepseek/deepseek-v4.1-flash
# Low temperature for all scoring jobs
LLM_TEMPERATURE=0.1

# --- TinyFish ---
TINYFISH_API_KEY=
# Comma-separated pool of keys from several accounts (each has its own budget). Overrides TINYFISH_API_KEY when set.
TINYFISH_API_KEYS=
TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai
TINYFISH_BROWSER_BASE_URL=https://api.browser.tinyfish.ai
TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai
# TinyFish Search (free), used by the tutorial-copy check. Leave empty to switch that search off.
TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
# Browser sessions end after this many seconds of inactivity (free tier maximum is 900)
TINYFISH_SESSION_TIMEOUT_SECONDS=300
# Agent runs at once per project (raise if TinyFish allows)
TINYFISH_PARALLEL_RUNS=5
# Total TinyFish credit available, and the part kept back. Paid calls stop before the reserve is touched.
TINYFISH_BUDGET_USD=10
TINYFISH_BUDGET_RESERVE_USD=2
# TinyFish prices, used to estimate the cost of each call (from the account's rate card)
TINYFISH_AGENT_STEP_USD=0.016
TINYFISH_BROWSER_MINUTE_USD=0.002

# --- Browser runner caps (one test run) ---
RUNNER_MAX_ACTIONS=40
RUNNER_MAX_ACTIONS_PER_STEP=6
RUNNER_MAX_SECONDS=240
# A longer plan gets more time: a run may take up to this many seconds per plan step when that is more than the line above
RUNNER_SECONDS_PER_STEP=60
# 1 = steps that name one clear action ("type 'milk' into ...", "click Add") are done by plain code, with no model call; 0 = always ask the model
RUNNER_MODEL_FREE_STEPS=1
# How much of the page's accessibility snapshot the model reads each time, in characters
RUNNER_SNAPSHOT_CHARS=6000
# Folder the agent may upload test files from (known-answer photos, the test resume)
TEST_FILES_DIR=testdata

# --- Safety limits on live sites ---
MAX_TRIES_PER_CLAIM=3
MAX_AGENT_RUNS_PER_PROJECT=30
# Seconds to wait for a sleeping host before judging a page
SLEEPING_HOST_WAIT_SECONDS=60
# Extra checks (bad input, known answer, repeat) run per claim after a good main test, for score evidence
EXTRA_TESTS_PER_CLAIM=1

# --- GitHub and Codeforces ---
# GitHub API address and a read-only token (public repository data only; no write access needed)
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
# Codeforces public API address (no key needed)
CODEFORCES_API_BASE_URL=https://codeforces.com/api
# LeetCode's public data address, the same no-login data its profile pages read. Empty: the profile page is read instead
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
# LeetCode Code Replay paste check (stage leetcode_replay, public data, no login): the last N contests plus any with a
# rating gain of at least RATING_JUMP; contests newer than SETTLE_DAYS are skipped. A paste is helper code if shorter than
# MIN_LINES or within TEMPLATE_SECONDS of opening the problem; Medium if at most MAX_EDITS_AFTER edits follow it; Strong
# when Medium pastes show up in REPEAT_CONTESTS contests
LEETCODE_REPLAY_CONTESTS=5
# The candidate report waits up to this many seconds for the coding profile checks, then is built without them
REPORT_CODING_WAIT_SECONDS=480
LEETCODE_REPLAY_RATING_JUMP=100
LEETCODE_REPLAY_SETTLE_DAYS=7
LEETCODE_PASTE_MIN_LINES=4
LEETCODE_PASTE_TEMPLATE_SECONDS=60
LEETCODE_PASTE_MAX_EDITS_AFTER=3
LEETCODE_PASTE_REPEAT_CONTESTS=3
# Same code as other contestants: a Medium paste of at least MIN_LINES is compared with the final code of people on
# MATCH_PAGES ranking pages each side of the candidate (needs BROWSERLESS_BQL_URL + BROWSERLESS_TOKEN: the ranking sits
# behind a Cloudflare check). MIN_USERS people with at least MATCH_PCT% of the paste in their code make it Strong
LEETCODE_MATCH_MIN_LINES=12
LEETCODE_MATCH_PAGES=5
LEETCODE_MATCH_PCT=90
LEETCODE_MATCH_MIN_USERS=2
# Backup browser for the live test when TinyFish is unavailable: a Chrome-over-CDP endpoint. Hosted Browserless
# /stealth (wss://production-sfo.browserless.io/stealth) also solves CAPTCHAs during the test; a self-hosted container
# (ws://browserless:3000) cannot, so a CAPTCHA there is still "could not test". Empty = no fallback.
BROWSERLESS_CDP_URL=
BROWSERLESS_TOKEN=
# LinkedIn (recruiter mode: confirm a candidate's LinkedIn account). Browserless BQL with stealth, residential
# proxy and CAPTCHA solving, logged in to the team account. Uses BROWSERLESS_TOKEN. Empty = off.
BROWSERLESS_BQL_URL=https://production-sfo.browserless.io/stealth/bql
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Authorship proof (GitHub history): files read per feature, features per project, commits per file,
# and how many branch commits are read to tie GitHub push records to commits
GITHUB_HISTORY_FILES_PER_CLAIM=15
GITHUB_HISTORY_CLAIMS_PER_PROJECT=40
GITHUB_HISTORY_COMMITS_PER_FILE=100
GITHUB_HISTORY_BRANCH_COMMITS=1000
# Voice walkthrough: biggest recorded question accepted (bytes), and questions per project per 24 hours
WALKTHROUGH_AUDIO_MAX_BYTES=10485760
WALKTHROUGH_QUESTIONS_PER_DAY=30

# --- Login ladder ---
AGENTMAIL_API_KEY=
AGENTMAIL_BASE_URL=https://api.agentmail.to
# The one inbox used for every email sign-up on tested sites. No other addresses are made.
AGENTMAIL_INBOX=talnex@agentmail.to
# Seconds to wait for a verification email, and how often to look
AGENTMAIL_WAIT_SECONDS=90
AGENTMAIL_POLL_SECONDS=3
# Makes the throwaway passwords for sign-ups on tested sites. Any long random text. Without it, email sign-up is off
EMAIL_LOGIN_SECRET=
AGENTCALL_API_KEY=
SMS_GATEWAY_URL=
# Phone way-in: the team SIM number in international format, e.g. +919876543210. Empty = phone sign-up is off
TEAM_PHONE_NUMBER=
# Seconds to wait for a text message with a code, and how often to look
SMS_WAIT_SECONDS=90
SMS_POLL_SECONDS=3
# Secret the phone app sends as X-Gateway-Key when it forwards a text to POST /v1/sms/incoming.
# At least 16 characters. Empty = the route answers 503 and accepts nothing
SMS_GATEWAY_KEY=

# --- Deploying the planted test apps (Vercel) ---
# Optional if you ran `npx vercel login`; otherwise create a token at vercel.com/account/tokens
VERCEL_TOKEN=

# --- Sandbox host (built in the last phase) ---
# Where callers reach sandboxd. From a container on the sandbox host: http://host.docker.internal:7070
SANDBOXD_URL=
# A long random string. Every sandboxd call except /healthz must carry it. Never share it.
SANDBOXD_TOKEN=
# Where sandboxd itself listens (it runs on the sandbox host, not in Docker Compose)
SANDBOXD_LISTEN_ADDR=0.0.0.0:7070
# Which driver sandboxd uses: docker or firecracker
SANDBOX_DRIVER=docker
SANDBOX_MAX_PARALLEL_VMS=4
SANDBOX_VM_CPUS=2
SANDBOX_VM_MEMORY_MB=4096
SANDBOX_BUILD_TIMEOUT_SECONDS=600
SANDBOX_VM_TIME_LIMIT_SECONDS=900
# How often the reaper looks for VMs past their time limit
SANDBOX_REAP_SECONDS=10
# How long a caller waits for a free place when the host is already running its maximum number of VMs
SANDBOX_BUSY_WAIT_SECONDS=600
# The code review reads this many source files, and at most this many kilobytes of code, for each claim
SANDBOX_REVIEW_MAX_FILES=12
SANDBOX_REVIEW_MAX_KB=120
# Open-theme events: the claims come from reading the project's code. At most this many files, and this many kilobytes of code, are read,
# and at most this many features become claims
FEATURE_READ_MAX_FILES=25
FEATURE_READ_MAX_KB=200
FEATURE_MAX_CLAIMS=12
# Copy check between teams: this share of the smaller team's own code is a review flag, this share a strong flag; code that at least
# this share of the teams (and 3 teams) have is starter code and is ignored; at most this many teams are read; the model looks at this many top files
COPY_REVIEW_PCT=40
COPY_STRONG_PCT=70
COPY_STARTER_SHARE=0.5
COPY_MAX_TEAMS=60
COPY_LOOK_MAX_FILES=3
# Authorship proof, finding the code: at most this many code files are read (free Fetch), however big the repo;
# at most this many claims are traced per project and this many files kept per claim; a code map less sure than this is "code not found"
AUTHORSHIP_LOCATE_MAX_FILES=40
AUTHORSHIP_MAX_CLAIMS=25
AUTHORSHIP_MAX_FILES_PER_CLAIM=6
AUTHORSHIP_MIN_CONFIDENCE=0.6
# Authorship proof, reading the history: the model sees this many top commits (new, moved or reformatting?); flag thresholds as shares 0 to 1:
# one commit holding this much with no later edits; pushed before the event (review, strong on a main feature); "I built" under this share; reformatting over this
AUTHORSHIP_TOP_COMMITS=8
AUTHORSHIP_ONE_DROP_SHARE=0.8
AUTHORSHIP_BEFORE_EVENT_REVIEW=0.3
AUTHORSHIP_BEFORE_EVENT_STRONG=0.6
AUTHORSHIP_CLAIMED_MIN_SHARE=0.2
AUTHORSHIP_REFORMAT_SHARE=0.5
# Voice walkthrough: one answer reads at most this many code files, this many lines from each, and shows this many lines with each code link
WALKTHROUGH_MAX_FILES=8
WALKTHROUGH_MAX_LINES_PER_FILE=120
WALKTHROUGH_SNIPPET_LINES=20
# Speech to text (faster-whisper) for recorded questions: model size, device (cpu or cuda) and compute type
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Guided tour walkthrough (architecture section 32) ---
# Tours (chats) one project may start per day. 0 = no limit. Each tour's browser run also counts toward MAX_AGENT_RUNS_PER_PROJECT
TOUR_MAX_PER_PROJECT_PER_DAY=10
# Browser actions in one tour message
TOUR_MAX_BROWSER_STEPS=12
# Minutes a chat's read-only code VM lives (the sandbox host's reaper removes it after that)
TOUR_VM_MINUTES=30
# List, search and read calls the guide agent may make before it must write the tour
TOUR_GUIDE_MAX_TOOL_CALLS=12
# Biggest repository download accepted (MB), biggest code file kept (KB), most files put in the code VM
TOUR_REPO_MAX_MB=30
TOUR_FILE_MAX_KB=200
TOUR_MAX_FILES=3000
# Model for the guide agent that reads the code and writes the tour (one model serves every role for now)
MODEL_TOUR_GUIDE=deepseek/deepseek-v4.1-flash
